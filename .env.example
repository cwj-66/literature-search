# 复制为 .env 后填写。不要把真实密钥提交到 Git。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=deepseek-v4.1-flash

# 可选密钥：未配置时使用匿名接口（共享额度，可能限流）。
# 填写获批邮件中的完整 S2 API Key；后端自动放入 x-api-key 请求头。
# 搜索、详情、引用和重试共用限速，每次请求完成后至少等待 1.1 秒。
# 同一密钥请勿同时用于其他实例，以免叠加超过所有接口合计 1 次/秒的额度。
SEMANTIC_SCHOLAR_API_KEY=

# 如需由管理员临时停用来源，设置为 false。
SEMANTIC_SCHOLAR_ENABLED=true
# 本地默认 backend/data/papers.sqlite3；容器由 compose 指定持久卷路径。

# 向量与重排序只使用硅基流动，不回退到其他提供方。
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
RERANK_MODEL=BAAI/bge-reranker-v2-m3
CROSSREF_MAILTO=

# 全部向量入口（全文索引、证据检索、论文相似度搜索）共用此模型。
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3

# MinerU 文档解析。在 https://mineru.net/apiManage 创建 Token。
MINERU_API_TOKEN=
MINERU_API_BASE=https://mineru.net
MINERU_MODEL=vlm
MINERU_POLL_LIMIT=120
MINERU_POLL_INTERVAL=2
# 后台导入队列：获取公开 PDF → MinerU → SQLite/FAISS。0 可禁用 worker。
PAPER_PROCESSING_WORKER=1
# 三项权重会先归一化，再换算成 0–100 的关联强度。
RELATION_WEIGHT_SEMANTIC=0.55
RELATION_WEIGHT_KEYWORD=0.25
RELATION_WEIGHT_CITATION=0.20

# LangSmith 追踪（可选）：在 https://smith.langchain.com 注册后，
# Settings → API Keys → Create API Key 生成密钥。两个变量同时配置才启用，留空则完全关闭。
LANGCHAIN_TRACING_V2=
LANGCHAIN_API_KEY=
# 可选：LangSmith 后台里的项目名，默认 default。
LANGCHAIN_PROJECT=paper-research
