# 复制为 .env 后填写。不要把真实密钥提交到 Git。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=deepseek-v4.1-flash

# 可选密钥：未配置时使用匿名接口（共享额度，可能限流）。
SEMANTIC_SCHOLAR_API_KEY=

# 如需由管理员临时停用来源，设置为 false。
SEMANTIC_SCHOLAR_ENABLED=true
# 本地默认 backend/data/papers.sqlite3；容器由 compose 指定持久卷路径。

# 硅基流动：配置后向量与重排序走硅基流动。未配置时向量仍可用 DashScope。
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
RERANK_MODEL=BAAI/bge-reranker-v2-m3
CROSSREF_MAILTO=

# 相似推荐的语义向量。沿用上面的 DashScope 兼容接口，失败时仍可按关键词和引用计算。
EMBEDDING_MODEL=text-embedding-v3
# index_paper 使用的硅基流动向量模型，与 EMBEDDING_MODEL 分开，避免混用向量空间。
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3

# MinerU 文档解析。在 https://mineru.net/apiManage 创建 Token。
MINERU_API_TOKEN=
MINERU_API_BASE=https://mineru.net
MINERU_MODEL=vlm
MINERU_POLL_LIMIT=120
MINERU_POLL_INTERVAL=2
# 后台导入队列：获取公开 PDF → MinerU → SQLite/FAISS。0 可禁用 worker。
PAPER_PROCESSING_WORKER=1
# 三项权重会先归一化，再换算成 0–100 的关联强度。
RELATION_WEIGHT_SEMANTIC=0.55
RELATION_WEIGHT_KEYWORD=0.25
RELATION_WEIGHT_CITATION=0.20
